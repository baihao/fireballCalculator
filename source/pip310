#!/bin/bash

# pip 3.10 包装脚本
# 直接调用环境中的pip，无需设置别名

ENV_PIP_PATH="/Users/hbai/miniconda3/envs/fireball_calculator/bin/pip"

# 检查环境是否存在
if [ ! -f "${ENV_PIP_PATH}" ]; then
    echo "错误: fireball_calculator 环境不存在"
    echo "请先运行 ./setup.sh 创建环境"
    exit 1
fi

# 直接调用环境中的pip
exec "${ENV_PIP_PATH}" "$@"
